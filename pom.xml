<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jrobertgardzinski</groupId>
    <artifactId>microservice-user-collections</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
      The sixth flavour: Helidon 4 SE on virtual threads (Loom). An imperative, blocking
      WebServer — so the correlation id, JDBC and Kafka stay simple, unlike a reactive stack —
      yet it scales on virtual threads.

      The estate's layers, as Maven modules rather than packages (2026-09-24), the same cut
      comments and memes got. Packages were a convention; modules are a CLASSPATH. The names are
      the estate's own, because an assembly that puts several services in one process picks the
      layers by name — a service that called its layers something else would not slot in.

        collections-domain         — the words a saved reference is made of. Pure JDK
        collections-config         — the typed dials. Pure JDK
        collections-application    — the use cases and the ports they speak through.
                                     Framework-free: no Helidon, no JDBC, no Kafka
        collections-infrastructure — everything with the outside in it: the WebServer, JDBC,
                                     Flyway, Kafka, the probes and main(). THE ONLY MODULE THAT
                                     PRODUCES A RUNNABLE ARTIFACT

      Helidon's `helidon-se` parent is gone and its BOM is imported instead. A parent applies to
      every module that inherits it, and its maven-jar-plugin config stamps Main-Class and a
      libs/ Class-Path into whatever jar it builds — true for the one module with a main(), wrong
      for the three libraries. What that parent gave us that we still want is stated below:
      managed versions (the import) and the two plugins that assemble the runnable jar, declared
      in collections-infrastructure and nowhere else.
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <helidon.version>4.5.1</helidon.version>
        <cucumber.version>7.34.9</cucumber.version>
        <junit-suite.version>6.1.3</junit-suite.version>
        <allure.version>2.35.4</allure.version>
        <pact.version>4.7.5</pact.version>
        <!-- the same Testcontainers the workspace already runs (microservice-memes gets 1.21.2
             from the Spring Boot 3.5.3 BOM; this Helidon build, like microservice-offboarding's,
             pins it explicitly since no BOM here manages it) -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- pinned here because there is no framework parent to pin them any more -->
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <dependency-plugin.version>3.8.1</dependency-plugin.version>
    </properties>

    <modules>
        <module>collections-domain</module>
        <module>collections-config</module>
        <module>collections-application</module>
        <module>collections_account-closure</module>
        <module>collections-infrastructure</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- FIRST, and that order is the point: the first declaration wins, and Helidon's BOM
                 (imported last, below) pins the JUnit Platform at 1.12.x, while cucumber 7.34 is
                 built against JUnit BOM 5.14.2 (platform 1.14.x) and its engine simply fails to
                 discover anything on the older one — reporting "TestEngine with ID 'cucumber'
                 failed to discover tests" with no stack trace at all. The version is cucumber's
                 own declared target, read from its pom, not guessed. This used to be won by being
                 in the project while Helidon's was in a parent; now it is won by being first. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.14.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- this service's own layers: one version, the reactor's -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>collections-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>collections-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>collections-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>collections_account-closure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- LAST: everything Helidon and its third-party stack manage — the WebServer,
                 Jackson, SLF4J, hamcrest. It loses to the two BOMs above wherever they overlap. -->
            <dependency>
                <groupId>io.helidon</groupId>
                <artifactId>helidon-dependencies</artifactId>
                <version>${helidon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- Allure results under target/ so mvn clean removes them -->
                            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- allure reports everywhere -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>3.0.3</version>
            </plugin>
        </plugins>
    </build>
</project>
